{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/jcyrus/open-labor-ph/main/data/schemas/benchmark_question_schema.json",
  "title": "RAG Evaluation Benchmark Question",
  "description": "Schema for benchmark questions used to evaluate LLM understanding of Philippine Labor Law",
  "type": "object",
  "required": [
    "id",
    "question",
    "expected_answer",
    "citations",
    "evidence",
    "key_points"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique question identifier (e.g., 'q001', 'termination_001')",
      "pattern": "^[a-z0-9_]+$"
    },
    "category": {
      "type": "string",
      "description": "Topic category for organization",
      "enum": [
        "termination",
        "probationary",
        "wages",
        "benefits",
        "leave",
        "osh",
        "labor_relations",
        "contracts",
        "telecommuting",
        "discrimination",
        "other"
      ]
    },
    "difficulty": {
      "type": "string",
      "description": "Difficulty level of the question",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "question": {
      "type": "string",
      "description": "The question to be asked to the LLM"
    },
    "expected_answer": {
      "type": "string",
      "description": "The expected correct answer or key points that should be covered"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Corpus passages that support the answer, by passage id (e.g. 'Labor Code Art. 297', 'DO-147-15 Rule I-A, Section 5')",
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Verbatim quotes that `evals check` finds in the cited passages",
      "items": {
        "type": "object",
        "required": [
          "citation",
          "quote"
        ],
        "additionalProperties": false,
        "properties": {
          "citation": {
            "type": "string",
            "description": "One of this question's citations"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "Text in that passage, ignoring case and whitespace"
          }
        }
      }
    },
    "key_points": {
      "type": "array",
      "minItems": 1,
      "description": "Facts an answer must state; scoring checks each one by phrase match",
      "items": {
        "type": "object",
        "required": [
          "label",
          "any_of"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "description": "What the fact is"
          },
          "any_of": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Phrasings that count as stating the fact"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords for filtering and search"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Where this question originated (e.g., 'hipstaff_users', 'dole_faq', 'legal_forum')"
        },
        "requires_context": {
          "type": "boolean",
          "description": "Whether this question requires RAG context to answer correctly",
          "default": true
        },
        "common_mistakes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Common incorrect answers or misconceptions"
        }
      }
    }
  }
}
